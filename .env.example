# Musin environment: secrets and per-machine settings (PRD §8.5).
# Copy to .env (gitignored) and fill in:  cp .env.example .env
# Anything that can change a number in the report belongs in
# config/pipeline.yaml instead. Adding a key here means updating the
# PRD §8.5 table in the same PR.
#
# Values below are for the reference machine (24 GB RAM, .wslconfig memory=18GB).
# On a smaller machine (sample mode only), lower the three memory values,
# e.g. SPARK_DRIVER_MEMORY=4g, NEO4J_HEAP_SIZE=2G, NEO4J_PAGECACHE_SIZE=1G.

# Absolute path inside WSL; "~" is NOT expanded. Must not be under /mnt/c.
MUSIN_DATA=/home/YOUR_WSL_USER/musin-data

# Neo4j login password for user "neo4j". At least 8 characters. Never commit it.
NEO4J_PASSWORD=

# Host ports for Neo4j Browser (HTTP) and Bolt (drivers, notebooks).
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# Memory. Spark and Neo4j heavy jobs never run at the same time (PRD §7.2).
SPARK_DRIVER_MEMORY=12g
NEO4J_HEAP_SIZE=8G
NEO4J_PAGECACHE_SIZE=5G
